# Copy to .env.local (gitignored). Never commit real tokens.

# Embedded MockThatInterview app (`npm run dev` locally; GitHub Pages workflow sets production URL.)
VITE_APP_FRONTEND_URL=http://localhost:5173

# Nest API root (no trailing /api) — iframe gets `mti_api_base` so bootstrap hits POST /embed/bootstrap.
# Vite dev for this demo defaults to http://localhost:8000 when unset; production build leaves it empty unless set.
VITE_MTI_API_BASE_URL=http://localhost:8000

# organisations.api_key for POST /embed/bootstrap (dev demo only)
VITE_MTI_ORG_API_TOKEN=

# Optional: GitHub Pages base when running `vite build` locally (CI sets this automatically).
# Example project site: VITE_PAGES_BASE=/mockthatinterview-lms-embedding-demo/
